# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=timetracker
DATABASE_URL=postgresql://timetracker:changeme@db:5432/timetracker

# ── MinIO (S3-compatible storage) — used for LOCAL Docker Compose ────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://storage:9000
MINIO_BUCKET=timetracker
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme

# ── Cloudflare R2 storage — used for CLOUD (Railway) deployment ──────────────
# Replace the MinIO vars above with these when deploying to Railway.
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API tokens
#
# MINIO_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# MINIO_BUCKET=timetracker
# AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>

# ── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_a_real_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ─────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme
FIRST_ADMIN_NAME=Admin
# Set to true to allow public self-registration (Phase 3 multi-tenant)
ALLOW_REGISTRATION=false

# ── Email (for dispute notifications) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Leave SMTP_HOST empty to disable email notifications

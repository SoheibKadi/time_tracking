# Time Tracker Agent — Configuration
# Copy this file to agent.env and fill in your values.

SERVER_URL=http://your-server:8000
ACCESS_TOKEN=
REFRESH_TOKEN=
CONTRACT_ID=
SCREENSHOT_INTERVAL_MIN=10
IDLE_TIMEOUT_MIN=5
IDLE_AUTOPAUSE_SEC=120
ACTIVITY_SCALE_FACTOR=150
SPOOL_DIR=spool
# Phase 3: set to false to capture primary monitor only
CAPTURE_ALL_MONITORS=true
